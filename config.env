# Variables used in various locations for processing data
# update to match your scope accordingly

#timezone
#used in analyze_data.py
PLOT_TIMEZONE=America/Denver
TIMEZONE=Etc/GMT+7

#SSIDs
#used in analyze_data.py
SSID1=eduroam
SSID2=BYU-WiFi

#Dates
#used in samples.py
START_DATE=2024-11-04
