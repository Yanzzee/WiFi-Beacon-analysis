# Corrected beacon-analysis workflow configuration.
# Command-line flags override these values.

# Named IANA timezone used to interpret schedules and display report times.
# Its date-specific rules transparently handle MST/MDT transitions.
TIMEZONE=America/Denver

# Inputs and run-scoped output root.
PROJECT_NAME=2026-classroom-captures
CAPTURES_FOLDER=data/captures

OUTPUT_FOLDER=output

SAMPLE_FOLDER=sample

# Inclusive class-schedule date range.
START_DATE=2026-11-09

END_DATE=2026-11-13

# Bounded concurrent capture extraction. Built-in fallback is 1; 4 is the
# current measured recommendation.
CAPTURE_WORKERS=8
# Detailed radio/class plots are opt-in; use --radio-class-plots when needed.
RADIO_CLASS_PLOTS=true

# Exploratory capture-quality expectation only. Default is 100 TU (0.1024 s).
# Override only if the transmitted beacon interval was intentionally changed.
#BEACON_INTERVAL_TU=100

# TShark and Aruba ERM decode settings. Capture type is detected per file.
#TSHARK_PATH=C:\temp\WiresharkPortable64\App\Wireshark\tshark.exe
ERM_UDP_PORT=5555
