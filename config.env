# Variables used in various locations for processing data
# update to match your scope accordingly

#timezone
#used in samples.py and analysis stages
#change timezone for daylight savings
PLOT_TIMEZONE=America/Denver
TIMEZONE=Etc/GMT+7

#folders
DATA_FOLDER=Data
CAPTURES_FOLDER=Data/captures
GROUPED_DATA_FOLDER=Data/grouped_data
PROCESSED_DATA_FOLDER=Data/processed_data
SAMPLED_FOLDER=Data/sampled
OUTPUT_FOLDER=Output
ALL_CLASS_BEACONS_FOLDER=Output/all_class_beacons
CLASS_SESSIONS_FOLDER=Output/class_sessions
PLOTS_FOLDER=Output/plots
RADIO_SUMMARY_FOLDER=Output/radio_summary
SAMPLE_FOLDER=Sample

#SSIDs
#used in analyze_data.py and downstream analysis stages
SSID1=eduroam
SSID2=BYU-WiFi

#Dates
#used in samples.py
#End date is inclusive of that day
START_DATE=2025-11-10
END_DATE=2025-11-14

#Beacons
#used in analyze_data.py and analyze_class_sessions.py
#IEEE 802.11 commonly defaults to a 0.1024 second beacon interval.
#This application's default is the effective metadata beacon interval, 1.024 seconds,
#because most vendors update beacon metadata every 10 beacon intervals.
#Aruba ERM captures/forwards these metadata updates at the longer interval even when
#the over-the-air beacon interval is shorter.
#BEACON_RATE is used for beacon deduplication and high-CU duration/window math.
BEACON_RATE=1.024

#Options
#used in analyze_data.py to create plot files for each radio/class or not
CREATE_PLOTS=yes
#for multi-process efficiency
THREAD_COUNT=8

#Capture type
CAPTURE_MODE=aruba_erm    #aruba_erm, over_the_air - erm is encapsulated within UDP
AP_PLATFORM=aruba         #aruba, extreme, none - used for ap name IEs
ERM_UDP_PORT=5555         # e.g. 5555
ERM_TYPE=aruba_erm_type0  # or aruba_erm_type6
